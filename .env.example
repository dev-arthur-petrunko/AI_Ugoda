# AI Ugoda — environment variables (copy to .env and adjust)
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=postgresql+psycopg2://aiugoda:aiugoda@localhost:5432/aiugoda
REDIS_URL=redis://localhost:6379/0

ZAKON_RADA_BASE_URL=https://zakon.rada.gov.ua
ZAKON_RADA_RSS_URL=https://zakon.rada.gov.ua/laws/main/rss
ZAKON_RADA_REQUEST_TIMEOUT=30
ZAKON_RADA_MAX_RETRIES=3

# AI provider: groq | openai | mock
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

MAX_UPLOAD_MB=25
STORAGE_PATH=./data/uploads
CONTRACT_RETENTION_DAYS=90

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development